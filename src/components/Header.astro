---
import { SITE_TITLE } from "../consts";
import ThemeIcon from "./ThemeIcon.astro";
---

<header>
  <nav>
    <h2><a class="mono" href="/">{SITE_TITLE}</a></h2>
    <ThemeIcon />
  </nav>
</header>
<style>
  header {
    margin: 0;
    padding: 0 1em;
  }
  h2 {
    margin: 0;
    font-size: 1em;
    letter-spacing: normal;
  }

  h2 a,
  h2 a.active {
    text-decoration: none;
  }
  nav {
    padding-top: 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  nav a {
    padding: 1em 0.5em;
    color: var(--muted);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-decoration: none;
    transition: color 0.2s;
  }
  nav a:hover {
    color: var(--text);
  }
</style>
